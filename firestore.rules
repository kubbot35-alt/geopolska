rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable hardened primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'jakub.j.linert@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin()
        || (isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function hasProfile(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    // Validation Blueprint: UserProfile
    function isValidUserProfile(data) {
      return data.keys().hasAll([
        'uid',
        'displayName',
        'photoUrl',
        'gamesPlayed',
        'bestScore',
        'totalScore',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'uid',
        'displayName',
        'photoUrl',
        'gamesPlayed',
        'bestScore',
        'totalScore',
        'createdAt',
        'updatedAt'
      ]) &&
      isValidId(data.uid) &&
      data.uid == request.auth.uid &&
      data.displayName is string &&
      data.displayName.size() >= 1 &&
      data.displayName.size() <= 60 &&
      data.photoUrl is string &&
      data.photoUrl.size() <= 500 &&
      data.gamesPlayed is int &&
      data.gamesPlayed >= 0 &&
      data.gamesPlayed <= 100000 &&
      data.bestScore is int &&
      data.bestScore >= 0 &&
      data.bestScore <= 25000 &&
      data.totalScore is int &&
      data.totalScore >= 0 &&
      data.totalScore <= 2500000000 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // Validation Blueprint: GameRecord (append-only match history supporting 3, 5, 10, 15, or 20 rounds)
    function isValidGameRecord(data) {
      return data.keys().hasAll([
        'uid',
        'playerName',
        'totalScore',
        'averageDistanceKm',
        'timedMode',
        'roundsCount',
        'roundLocations',
        'roundScores',
        'roundDistances',
        'createdAt'
      ]) &&
      data.keys().hasOnly([
        'uid',
        'playerName',
        'totalScore',
        'averageDistanceKm',
        'timedMode',
        'roundsCount',
        'roundLocations',
        'roundScores',
        'roundDistances',
        'createdAt'
      ]) &&
      isValidId(data.uid) &&
      data.uid == request.auth.uid &&
      data.playerName is string &&
      data.playerName.size() >= 1 &&
      data.playerName.size() <= 60 &&
      data.roundsCount is int &&
      data.roundsCount in [3, 5, 10, 15, 20] &&
      data.totalScore is int &&
      data.totalScore >= 0 &&
      data.totalScore <= data.roundsCount * 5000 &&
      data.averageDistanceKm is number &&
      data.averageDistanceKm >= 0 &&
      data.averageDistanceKm <= 25000 &&
      data.timedMode is bool &&
      data.roundLocations is list &&
      data.roundLocations.size() == data.roundsCount &&
      data.roundLocations.size() <= 20 &&
      data.roundLocations[0] is string &&
      data.roundLocations[0].size() <= 80 &&
      data.roundScores is list &&
      data.roundScores.size() == data.roundsCount &&
      data.roundScores.size() <= 20 &&
      data.roundScores[0] is int &&
      data.roundScores[0] >= 0 &&
      data.roundScores[0] <= 5000 &&
      data.roundDistances is list &&
      data.roundDistances.size() == data.roundsCount &&
      data.roundDistances.size() <= 20 &&
      data.roundDistances[0] is number &&
      data.roundDistances[0] >= 0 &&
      data.createdAt is timestamp;
    }

    // Validation Blueprint: LeaderboardEntry (public, zero PII, normalized 5-round scale 0..25000)
    function isValidLeaderboardEntry(data) {
      return data.keys().hasAll([
        'uid',
        'playerName',
        'photoUrl',
        'bestScore',
        'averageDistanceKm',
        'gamesPlayed',
        'timedMode',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'uid',
        'playerName',
        'photoUrl',
        'bestScore',
        'averageDistanceKm',
        'gamesPlayed',
        'timedMode',
        'createdAt',
        'updatedAt'
      ]) &&
      isValidId(data.uid) &&
      data.uid == request.auth.uid &&
      data.playerName is string &&
      data.playerName.size() >= 1 &&
      data.playerName.size() <= 60 &&
      data.photoUrl is string &&
      data.photoUrl.size() <= 500 &&
      data.bestScore is int &&
      data.bestScore >= 0 &&
      data.bestScore <= 25000 &&
      data.averageDistanceKm is number &&
      data.averageDistanceKm >= 0 &&
      data.averageDistanceKm <= 25000 &&
      data.gamesPlayed is int &&
      data.gamesPlayed >= 1 &&
      data.gamesPlayed <= 100000 &&
      data.timedMode is bool &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // Validation Blueprint: DailyLeaderboardEntry (public, zero PII, immutable 1 official run per day)
    function isValidDailyLeaderboardEntry(data) {
      return data.keys().hasAll([
        'dateKey',
        'uid',
        'playerName',
        'photoUrl',
        'score',
        'averageDistanceKm',
        'timedMode',
        'createdAt'
      ]) &&
      data.keys().hasOnly([
        'dateKey',
        'uid',
        'playerName',
        'photoUrl',
        'score',
        'averageDistanceKm',
        'timedMode',
        'createdAt'
      ]) &&
      data.dateKey is string &&
      data.dateKey.size() == 10 &&
      data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
      isValidId(data.uid) &&
      data.uid == request.auth.uid &&
      data.playerName is string &&
      data.playerName.size() >= 1 &&
      data.playerName.size() <= 60 &&
      data.photoUrl is string &&
      data.photoUrl.size() <= 500 &&
      data.score is int &&
      data.score >= 0 &&
      data.score <= 25000 &&
      data.averageDistanceKm is number &&
      data.averageDistanceKm >= 0 &&
      data.averageDistanceKm <= 25000 &&
      data.timedMode is bool &&
      data.createdAt is timestamp;
    }

    // Validation Blueprint: LocationDocument (public atlas, admin-writable, Poland WGS84 bounds)
    function isValidLocationDocument(data, locationId) {
      return data.keys().hasAll([
        'id',
        'catalogKey',
        'name',
        'voivodeship',
        'lat',
        'lng',
        'imageUrl',
        'hint',
        'funFact',
        'regionCategory',
        'isClassicOffline',
        'orderIndex',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id',
        'catalogKey',
        'name',
        'voivodeship',
        'lat',
        'lng',
        'imageUrl',
        'hint',
        'funFact',
        'regionCategory',
        'isClassicOffline',
        'orderIndex',
        'createdAt',
        'updatedAt'
      ]) &&
      isValidId(data.id) &&
      data.id == locationId &&
      data.catalogKey is string &&
      data.catalogKey.size() == 6 &&
      data.catalogKey == 'poland' &&
      data.name is string &&
      data.name.size() >= 1 &&
      data.name.size() <= 120 &&
      data.voivodeship is string &&
      data.voivodeship.size() >= 1 &&
      data.voivodeship.size() <= 60 &&
      data.lat is number &&
      data.lat >= 48.5 &&
      data.lat <= 55.5 &&
      data.lng is number &&
      data.lng >= 13.5 &&
      data.lng <= 25.0 &&
      data.imageUrl is string &&
      data.imageUrl.size() >= 1 &&
      data.imageUrl.size() <= 500 &&
      data.hint is string &&
      data.hint.size() >= 1 &&
      data.hint.size() <= 500 &&
      data.funFact is string &&
      data.funFact.size() >= 1 &&
      data.funFact.size() <= 600 &&
      data.regionCategory is string &&
      data.regionCategory.size() >= 1 &&
      data.regionCategory.size() <= 16 &&
      data.regionCategory in ['miasto', 'gory', 'morze', 'zabytek', 'nad_woda'] &&
      data.isClassicOffline is bool &&
      data.orderIndex is int &&
      data.orderIndex >= 0 &&
      data.orderIndex <= 100000 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // Validation Blueprint: CatalogMeta (lightweight manifest for 1-read cache invalidation)
    function isValidCatalogMeta(data, catalogId) {
      return data.keys().hasAll([
        'id',
        'version',
        'totalCount',
        'updatedBy',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id',
        'version',
        'totalCount',
        'updatedBy',
        'createdAt',
        'updatedAt'
      ]) &&
      isValidId(data.id) &&
      data.id.size() <= 64 &&
      data.id == catalogId &&
      data.version is int &&
      data.version >= 1 &&
      data.version <= 1000000 &&
      data.totalCount is int &&
      data.totalCount >= 0 &&
      data.totalCount <= 100000 &&
      isValidId(data.updatedBy) &&
      data.updatedBy == request.auth.uid &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // Collection 1: Owner-isolated user profiles
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'photoUrl',
          'gamesPlayed',
          'bestScore',
          'totalScore',
          'updatedAt'
        ]);
      allow delete: if false;
    }

    // Collection 2: Owner-only append-only match history
    match /games/{gameId} {
      allow get: if isValidId(gameId)
        && isSignedIn()
        && (resource == null || existing().uid == request.auth.uid);
      allow list: if isSignedIn()
        && resource.data.uid == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(gameId)
        && isValidGameRecord(incoming())
        && incoming().createdAt == request.time
        && hasProfile(request.auth.uid);
      allow update: if false;
      allow delete: if false;
    }

    // Collection 3: Public global leaderboard (zero PII)
    match /leaderboard/{userId} {
      allow get: if isValidId(userId)
        && (resource == null
          || (existing().bestScore is int
            && existing().bestScore >= 0
            && existing().bestScore <= 25000));
      allow list: if resource.data.bestScore is int
        && resource.data.bestScore >= 0
        && resource.data.bestScore <= 25000;
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidLeaderboardEntry(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && hasProfile(request.auth.uid);
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidLeaderboardEntry(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'playerName',
          'photoUrl',
          'bestScore',
          'averageDistanceKm',
          'gamesPlayed',
          'timedMode',
          'updatedAt'
        ]);
      allow delete: if false;
    }

    // Collection 4: Public daily challenge leaderboard (immutable, 1 official run per player per day, zero PII)
    match /dailyLeaderboard/{entryId} {
      allow get: if isValidId(entryId)
        && (resource == null
          || (existing().score is int
            && existing().score >= 0
            && existing().score <= 25000));
      allow list: if resource.data.score is int
        && resource.data.score >= 0
        && resource.data.score <= 25000;
      allow create: if isVerifiedUser()
        && isValidId(entryId)
        && entryId == incoming().dateKey + '_' + request.auth.uid
        && isValidDailyLeaderboardEntry(incoming())
        && incoming().createdAt == request.time
        && hasProfile(request.auth.uid);
      allow update: if false;
      allow delete: if false;
    }

    // Collection 5: Public GeoPolska location atlas (admin-managed, zero PII)
    match /locations/{locationId} {
      allow get: if isValidId(locationId)
        && (resource == null || existing().catalogKey == 'poland');
      allow list: if resource.data.catalogKey == 'poland';
      allow create: if isVerifiedUser()
        && isValidId(locationId)
        && isValidLocationDocument(incoming(), locationId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isAdmin();
      allow update: if isVerifiedUser()
        && isValidId(locationId)
        && isValidLocationDocument(incoming(), locationId)
        && isAdmin()
        && incoming().id == existing().id
        && incoming().catalogKey == existing().catalogKey
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name',
          'voivodeship',
          'lat',
          'lng',
          'imageUrl',
          'hint',
          'funFact',
          'regionCategory',
          'isClassicOffline',
          'orderIndex',
          'updatedAt'
        ]);
      allow delete: if isVerifiedUser()
        && isValidId(locationId)
        && isAdmin();
    }

    // Collection 6: Single-document catalog version manifest (no list allowed)
    match /catalogMeta/{catalogId} {
      allow get: if isValidId(catalogId)
        && (resource == null || (existing().version is int && existing().version >= 1));
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidId(catalogId)
        && isValidCatalogMeta(incoming(), catalogId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isAdmin();
      allow update: if isVerifiedUser()
        && isValidId(catalogId)
        && isValidCatalogMeta(incoming(), catalogId)
        && isAdmin()
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'version',
          'totalCount',
          'updatedBy',
          'updatedAt'
        ]);
      allow delete: if false;
    }

    // Collection 7: Admin privilege markers (never client-writable)
    match /admins/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}
